{
    "name": "@quantumbpm/sdk",
    "version": "1.0.0",
    "description": "QuantumBPM TypeScript/JavaScript SDK — DMN evaluation, BPMN orchestration, and external job workers.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "jest",
        "generate": "openapi-typescript-codegen --input openapi.yaml --output src/generated --client axios --name RawClient",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "quantumbpm",
        "dmn",
        "bpmn",
        "decision",
        "workflow",
        "feel",
        "sdk"
    ],
    "author": "QuantumBPM",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/QuantumBPM/quantum-js-sdk.git"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "jsonwebtoken": "^9.0.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.0.0",
        "jest": "^29.7.0",
        "openapi-typescript-codegen": "^0.30.0",
        "ts-jest": "^29.1.0",
        "typescript": "^5.3.0"
    },
    "files": [
        "dist",
        "src"
    ]
}
